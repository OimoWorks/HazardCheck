# Google Geocoding API フォールバック用キー（省略可）。
# 未設定の場合、国土地理院 住所検索APIのみで解決を試みる。
GOOGLE_MAPS_API_KEY=

# 1に設定すると、/api/geocode がGSI・Googleそれぞれの生レスポンスや、
# 番地不一致で却下した候補をサーバーログに出力する（住所が意図しない場所に
# ジオコーディングされる問題の調査用）。本番では通常オフのままでよい。
GEOCODE_DEBUG=

# GA4 測定ID（例: G-XXXXXXXXXX）。未設定の場合はGA4イベントを送信しない（コンソールログのみ）。
VITE_GA_MEASUREMENT_ID=

# 防災グッズシミュレーターの公開URL（確定次第設定。未設定ならフッターにリンクを表示しない）。
VITE_GOODS_SIMULATOR_URL=
